# Which Velista API the app talks to. Restart Expo with `npx expo start -c` after changing this file.
#
# Leave it unset to use the deployed API (https://aiproductlisting-production.up.railway.app).
# local                    -> the Velista server on the computer running Expo (port 3000)
# https://your-server.com  -> any other server
# EXPO_PUBLIC_API_URL=local
