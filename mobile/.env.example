# Copy to .env only if the app cannot find your Velista server on its own.
# In development the app uses the computer running Expo (same address as Metro, port 3000), and
# the Android emulator falls back to http://10.0.2.2:3000. Restart Expo after changing this file.
#
# Phone on the same Wi-Fi as your computer: http://<your-computer-LAN-IP>:3000
# Android emulator:                         http://10.0.2.2:3000
# iOS simulator:                            http://localhost:3000
# Production builds: your HTTPS server URL (required).
# EXPO_PUBLIC_API_URL=https://api.example.com
