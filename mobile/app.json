{
  "expo": {
    "name": "Velista",
    "slug": "velista-listing-ai",
    "scheme": "velista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velista.listingai",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.velista.listingai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F4F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Velista uses the microphone to record voice notes about your products."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Velista needs access to your photos to build listings from them.",
          "cameraPermission": "Velista uses the camera to capture product photos and videos.",
          "microphonePermission": "Velista records sound with product videos."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
