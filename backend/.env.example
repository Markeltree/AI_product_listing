# ----------------------------------------------------------------------------
# Velista Listing AI - copy this file to .env and fill in your keys.
# The server reads .env on startup. Restart it after every change.
# ----------------------------------------------------------------------------

PORT=3000
# Comma-separated origins allowed to call the API from a browser, for example the Expo web preview.
# Leave blank for phones (native apps do not use CORS).
CORS_ORIGINS=
# Public URL of the app. Used for the Etsy redirect and links back to the app.
APP_URL=http://localhost:3000

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Database (Supabase) ---------------------------------------------------
# Leave both blank to use a local SQLite file in data/ (fine for development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Etsy Open API ---------------------------------------------------------
# Keystring from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
# Shared secret, only if your Etsy app shows one (sent as keystring:secret).
ETSY_SHARED_SECRET=
# Must match the redirect URI registered in your Etsy app.
# Defaults to APP_URL + /api/etsy/callback when left blank.
ETSY_REDIRECT_URI=
# Scopes requested during connection. Change only if you know you need more.
ETSY_SCOPES=email_r shops_r listings_r listings_w

# Advanced: leave blank in production. Used to point at the local mock (npm run mock:etsy).
# ETSY_API_BASE=
# ETSY_AUTHORIZE_URL=
# ETSY_TOKEN_URL=

# ---- AI providers ----------------------------------------------------------
# Anthropic (preferred). Used for vision analysis when set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI. Used for voice-note transcription, and for vision if no Anthropic key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- eBay (Sell APIs) --------------------------------------------------------
# 1. developer.ebay.com -> Application Keys: create a keyset (Sandbox to test, Production to sell).
# 2. User Tokens -> add a RuName. Set its "auth accepted URL" and "auth declined URL" to
#    APP_URL + /api/ebay/callback. eBay requires HTTPS, so APP_URL must be HTTPS (tunnel or deployed URL).
# 3. Copy the App ID, Cert ID and the RuName (not the URL) below.
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# ---- Cross-delist ------------------------------------------------------------
# Minutes between checks of listings live on both Etsy and eBay. When one sells or ends,
# the other is ended. 0 turns the background check off.
SYNC_INTERVAL_MINUTES=3

# ---- Video processing (ffmpeg) ---------------------------------------------
# Needed to pull key frames from product videos. Usually found automatically.
# Leave empty to use the ffmpeg/ffprobe bundled with the app (ffmpeg-static).
FFMPEG_PATH=
FFPROBE_PATH=
